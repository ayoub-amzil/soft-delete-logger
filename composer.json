{
  "name": "ayoub-amzil/soft-delete-logger",
  "description": "Log soft deletes and restore actions on Eloquent models with user tracking in Laravel.",
  "type": "library",
  "license": "MIT",
  "version": "1.0.0",
  "authors": [
    {
      "name": "Ayoub Amzil",
      "email": "dev.amzil.ayoub@gmail.com"
    }
  ],
  "require": {
    "php": "^8.1",
    "illuminate/support": "^12.0",
    "illuminate/database": "^12.0"
  },
  "autoload": {
    "psr-4": {
      "AyoubAmzil\\SoftDeleteLogger\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "AyoubAmzil\\SoftDeleteLogger\\SoftDeleteLoggerServiceProvider"
      ]
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
